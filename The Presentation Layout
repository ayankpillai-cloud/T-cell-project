body {
    background-color: #030303;
    color: #ffffff;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    margin: 0;
    padding: 20px;
    display: flex;
    justify-content: center;
}

#app-container {
    display: flex;
    background-color: #090909;
    border: 1px solid #222;
    border-radius: 8px;
    overflow: hidden;
    max-width: 1000px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.7);
}

#sidebar {
    width: 300px;
    padding: 20px;
    background-color: #050505;
    border-right: 1px solid #1a1a1a;
}

h2, h3 { margin-top: 0; color: #fff; }
label { display: block; margin: 12px 0 4px; font-size: 13px; color: #aaa; }
select, input[type="range"] { width: 100%; margin-bottom: 10px; }

#modifiers-panel {
    margin-top: 20px;
    padding: 10px;
    background: #0d0d0d;
    border-radius: 4px;
}
#modifiers-panel label { display: flex; align-items: center; gap: 8px; color: #fff; cursor: pointer;}

.btn-group { display: flex; gap: 10px; margin-top: 20px; }
button {
    flex: 1; padding: 10px; background: #111; border: 1px solid #333;
    color: white; border-radius: 4px; cursor: pointer; transition: 0.2s;
}
button:hover { background: #222; border-color: #555; }

#canvas-container { padding: 20px; position: relative; }
canvas { background: black; border-radius: 50%; box-shadow: 0 0 20px rgba(255,102,0,0.1); }

#telemetry {
    margin-top: 15px; display: flex; justify-content: space-between; font-size: 14px;
}
#tel-cancer { color: #ff0033; font-weight: bold; }
#tel-tcell { color: #00b3ff; font-weight: bold; }
